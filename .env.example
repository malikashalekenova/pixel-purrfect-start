# Supabase project URL, from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=

# Supabase anon/public publishable key, from Supabase Dashboard > Project Settings > API.
# This is safe for browser use when Row Level Security policies are correct.
SUPABASE_PUBLISHABLE_KEY=

# Public Supabase project URL for the Vite client bundle.
VITE_SUPABASE_URL=

# Public Supabase anon/publishable key for the Vite client bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Supabase project ID, from the Supabase project reference.
VITE_SUPABASE_PROJECT_ID=

# Server-only Gemini API key for AI Mentor. Never expose this as VITE_*.
GEMINI_API_KEY=

# Server-only Gemini model for AI Mentor.
GEMINI_MODEL=gemini-2.5-flash-lite
